<script>
import {candidates,frontier,mean,gateOutcome,teachingBatch,breadthDemo,workload} from '../lib/rho-method.mjs';
class RhoMethod extends HTMLElement {
 connectedCallback(){
  if(this.dataset.ready)return;this.dataset.ready='true';
  const q=(s:string)=>this.querySelector(s) as HTMLElement;
  const all=(s:string)=>Array.from(this.querySelectorAll(s)) as HTMLElement[];
  const files=JSON.parse(q('.file-data').textContent!);
  all('[data-file]').forEach(b=>b.addEventListener('click',()=>{const f=files[Number(b.dataset.file)];q('.file-name').textContent=f[0];q('.file-heading').textContent=f[1];q('.file-description').textContent=f[2];all('[data-file]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));}));
  let draw=0;
  const renderBatch=()=>{const strat=(q('.sampler-mode') as HTMLSelectElement).value==='stratified';
   const groupCount=Number((q('.batch-groups') as HTMLInputElement).value),examples=Number((q('.batch-examples') as HTMLInputElement).value);
   const names=['Lift','Place','Stack'];const picks=teachingBatch(groupCount,examples,draw,strat);
   q('.group-count').textContent=String(groupCount);q('.example-count').textContent=String(examples);
   q('.batch-equation').textContent=`${groupCount} groups × ${examples} example${examples===1?'':'s'} = ${picks.length} instances`;
   all('[data-seed]').forEach(el=>el.classList.toggle('picked',picks.includes(el.dataset.seed!)));
   const distinct=new Set(picks.map(p=>p.split('-')[0])).size;
   q('.sampler-result').textContent=strat?`${picks.length} examples across ${distinct} distinct task families. Select an example below to inspect its feedback.`:`Flat sampling uses the same total batch size (${picks.length}), but this illustrative draw covers ${distinct} task ${distinct===1?'family':'families'}. Flat mode draws from the pooled instances.`;
   const show=(id:string)=>{const [g,seed]=id.split('-').map(Number);const reward=((g*3+seed*2+draw)%9+1)/10;const text=reward>=.8?'Object moved toward the target; verify final placement.':reward>=.5?'Grasp succeeded, but the object slipped during transport.':'Object remained on the table after the lift command.';
    q('.batch-payload').textContent=`${names[g]} · seed ${seed+1}\n\nscore: ${reward.toFixed(2)}\n\nside_info:\n  ${text}\n\nstdout:\n  observe → grasp → lift\n  verification: ${reward>=.8?'partial progress':'retry needed'}`;
    all('[data-feedback]').forEach(el=>el.setAttribute('aria-pressed',String(el.dataset.feedback===id)));
   };
   q('.feedback-example-list').replaceChildren(...picks.map(id=>{const [g,seed]=id.split('-').map(Number);const b=document.createElement('button');b.dataset.feedback=id;b.textContent=`${names[g]} · ${seed+1}`;b.addEventListener('click',()=>show(id));return b;}));show(picks[0]);
   this.dispatchEvent(new Event('batchchange'));
   q('.batch-cost').textContent=`${picks.length} parent examples supply feedback for this mutation; the child is scored on the same ${picks.length}. That is ${2*picks.length} evaluations before validation without caching, plus any debugging rollouts. Scores, traces, and stdout here are synthetic.`;
  };
  q('.draw-batch').addEventListener('click',()=>{draw++;renderBatch();});
  all('.batch-groups,.batch-examples,.sampler-mode').forEach(el=>el.addEventListener('input',renderBatch));renderBatch();
  const updateBudget=()=>{const groups=Number((q('.batch-groups') as HTMLInputElement).value),examples=Number((q('.batch-examples') as HTMLInputElement).value),generations=Number((q('.budget-total') as HTMLInputElement).value);const work=workload({generations,batch:groups*examples});
   q('.budget-linked').textContent=`Using your sampling settings: ${groups} groups × ${examples} example${examples===1?'':'s'} = ${groups*examples} instances per batch.`;q('.budget-total-value').textContent=String(generations);
   q('.prompt-records').replaceChildren(...Array.from({length:work.feedbackRecords},()=>document.createElement('i')));q('.rollout-records').replaceChildren(...Array.from({length:work.pairedPerGeneration},()=>document.createElement('i')));
   q('.prompt-volume').textContent=`${work.feedbackRecords} feedback records: scores, side information, and stdout.`;q('.rollout-volume').textContent=`${work.feedbackRecords} parent + ${work.feedbackRecords} child rollouts per generation.`;
   q('.work-summary').textContent=`${generations} planned generations, each with ${work.feedbackRecords} feedback examples and ${work.pairedPerGeneration} paired training rollouts: ${work.totalPairedRollouts.toLocaleString()} paired rollouts before caching, skips, debugging, and validation.`;
  };q('.budget-total').addEventListener('input',updateBudget);this.addEventListener('batchchange',updateBudget);updateBudget();
  all('[data-diagnosis]').forEach(b=>b.addEventListener('click',()=>{const frame=b.dataset.diagnosis==='frame';all('[data-diagnosis]').forEach(el=>{el.setAttribute('aria-pressed',String(el===b));el.classList.toggle('primary',el===b);});q('.diagnostic-trace').textContent=frame?'Trace: the commanded grasp pose is expressed in the camera frame, but motion expects world coordinates.':'Trace: the object is grasped and lifted, but the gripper opens before the arm reaches its placement pose.';q('.diagnostic-edit').textContent=frame?'Possible repair: compose the camera-to-world transform before planning motion.':'Possible repair: keep the gripper closed through transport and verify the placement pose before releasing.';}));
  const session=[
   ['INSPECT','grasp.pose.frame = "camera"\nmotion.expected_frame = "world"\n# The interfaces disagree.','The parent’s trace suggests that a camera-frame grasp was passed to a world-frame motion routine.',[]],
   ['EDIT','perception.py: export the camera pose\nmotion.py: compose camera → world\nverify.py: compare in the same frame','The agent edits cooperating modules so they agree on the meaning of a pose.',['perception','motion','verify']],
   ['TEST','run_temporary_test("pose_transform")\nrun_candidate_via_REaaS(task, seed)\n→ inspect the returned rollout','The agent checks the transform and runs a permitted environment trial before submitting the child.',['motion']],
   ['READ FEEDBACK','test: transform check passed\nrollout: object slipped after grasp\nvisual difference: object stayed on table','The transform test passes. The rollout then reveals a slipping grasp to investigate.',['verify']],
   ['REVISE','motion.py: approach, grasp, then lift\nverify.py: re-observe after the lift\nif not lifted: retry with another grasp','The agent uses the new evidence to add verification and a retry.',['motion','verify']],
   ['SUBMIT','child_repository = snapshot(edited_files)\nreturn child_repository\n# Independent evaluator decides acceptance.','Several edits and tool calls have produced one child repository. The outer search now evaluates it.',['perception','motion','verify']],
  ];let phase=0,timer:ReturnType<typeof setInterval>|undefined;
  const stop=()=>{clearInterval(timer);timer=undefined;q('.mutation-play').textContent='Play session';};
  const renderPhase=()=>{const item=session[phase];q('.terminal-label').textContent=item[0] as string;q('.session-code').textContent=item[1] as string;q('.session-explanation').textContent=item[2] as string;q('.mutation-counter').textContent=`${phase+1} / 6`;all('[data-phase]').forEach(b=>b.setAttribute('aria-pressed',String(Number(b.dataset.phase)===phase)));all('[data-module]').forEach(el=>el.classList.toggle('edited',(item[3] as string[]).includes(el.dataset.module!)));};
  all('[data-phase]').forEach(b=>b.addEventListener('click',()=>{phase=Number(b.dataset.phase);renderPhase();}));
  q('.mutation-next').addEventListener('click',()=>{phase=(phase+1)%6;renderPhase();});q('.mutation-reset').addEventListener('click',()=>{stop();phase=0;renderPhase();});
  q('.mutation-play').addEventListener('click',()=>{if(timer){stop();return;}if(phase===5)phase=0;renderPhase();q('.mutation-play').textContent='Pause session';timer=setInterval(()=>{if(phase>=5){stop();return;}phase++;renderPhase();if(phase===5)stop();},2200);});
  const visible=new IntersectionObserver(([e])=>{if(!e.isIntersecting)stop();});visible.observe(q('.mutation'));document.addEventListener('visibilitychange',()=>{if(document.hidden)stop();});
  const motion=matchMedia('(prefers-reduced-motion: reduce)');motion.addEventListener('change',()=>{if(motion.matches)stop();});
  const updateGate=()=>{const child=[Number((q('.child-one') as HTMLInputElement).value),Number((q('.child-two') as HTMLInputElement).value)];const equal=(q('.allow-equal') as HTMLInputElement).checked,staged=(q('.use-stage') as HTMLInputElement).checked;const stage=(q('.stage-case') as HTMLSelectElement);stage.disabled=!staged;const stageChild=stage.value==='pass'?[.7,.65]:stage.value==='tie'?[.6,.6]:[.4,.5];const result=gateOutcome([.3,.7],child,{equal,staged,stageChild});q('.score-one').textContent=child[0].toFixed(2);q('.score-two').textContent=child[1].toFixed(2);q('.child-sum').textContent=`Total ${(child[0]+child[1]).toFixed(2)}`;q('.gates .equation').innerHTML=`Σ s<sub>τ</sub>(child) ${equal?'≥':'&gt;'} Σ s<sub>τ</sub>(parent), for τ ∈ B`;
   q('[data-gate=train]').className=result==='reject-train'?'failed':'passed';q('[data-gate=stage]').className=!staged?'bypass':result==='reject-train'?'pending':result==='reject-stage'?'failed':'passed';q('[data-gate=full]').className=result==='full-validation'?'passed':'pending';q('.gate-result').textContent=result==='reject-train'?'Rejected on the paired training batch. The parent remains available; no full validation is purchased.':result==='reject-stage'?'The child passes training but fails staged validation. Evaluation stops at this gate.':`The child passes ${staged?'both gates':'the training gate'} and proceeds to full validation. Frontier retention is a separate decision.`;
  };all('.gates input,.gates select').forEach(el=>el.addEventListener('input',updateGate));updateGate();
  let current=frontier(candidates.slice(0,2));let n=2;let frontierMode='instance';
  const updateFrontier=()=>{n=Number((q('.frontier-stage') as HTMLSelectElement).value);frontierMode=(q('.frontier-mode') as HTMLSelectElement).value;const rows=candidates.slice(0,n);current=frontier(rows,frontierMode);all('[data-key-header]').forEach((el,i)=>el.textContent=frontierMode==='instance'?`τ${i+1}`:['Grasp','Lift','Place','Finish'][i]);all('[data-candidate]').forEach((el,i)=>{el.hidden=i>=n;el.classList.remove('selected');el.classList.toggle('pruned',!current.alive.has(candidates[i].id));(el.querySelector('.chance') as HTMLElement).textContent=current.alive.has(candidates[i].id)?`${(current.probability[candidates[i].id]*100).toFixed(0)}%`:'Pruned';el.querySelectorAll('.reward-cell').forEach((cell,j)=>{const v=frontierMode==='instance'?candidates[i].scores[j]:candidates[i].objectives[j];cell.textContent=v.toFixed(2);(cell as HTMLElement).style.setProperty('--reward',`${v*100}%`);cell.classList.toggle('best',i<n&&current.alive.has(candidates[i].id)&&Math.abs(v-current.best[j])<1e-9);});});q('.frontier-tickets').replaceChildren(...rows.filter(r=>current.alive.has(r.id)).map(r=>{const el=document.createElement('span');el.textContent=`${r.id} · ${current.coverage[r.id]} ticket${current.coverage[r.id]===1?'':'s'}`;return el;}));q('.deploy-choice').textContent=current.selected.id;q('.sample-result').textContent='Sample a parent: each surviving best-key occurrence contributes one ticket.';q('.frontier-result').textContent=frontierMode==='objective'?`Objective frontier: ${[...current.alive].join(', ')} survive. Keys are the mean Grasp, Lift, Place, and Finish objectives in this toy example. ${n===4?'A loses its objective keys to C, even though A survives in instance mode.':'Switch modes to compare retention under different keys.'}`:n===2?'A is best on instances 1 and 3; B is best on 2 and 4. Both survive, with equal selection probability.':n===3?'E ties the best on instances 1 and 2, but A and B already cover those keys. E is pruned even though neither specialist alone matches all of its scores.':n===4?'C sets a new best on instance 1. A still owns instance 3, and B still owns instance 4. All three survive; B appears on two best keys.':'D matches or exceeds every current instance best. It retains all four keys, so the older candidates’ coverage becomes redundant.';};q('.frontier-stage').addEventListener('change',updateFrontier);q('.frontier-mode').addEventListener('change',updateFrontier);
  q('.sample-parent').addEventListener('click',()=>{const tickets=candidates.slice(0,n).flatMap(r=>Array(current.coverage[r.id]).fill(r.id));const id=tickets[Math.floor(Math.random()*tickets.length)];all('[data-candidate]').forEach(el=>el.classList.toggle('selected',el.dataset.candidate===id));q('.sample-result').textContent=`Selected ${id} as the next parent (${(current.probability[id]*100).toFixed(0)}% chance per draw).`;});
  const updateBreadth=()=>{const count=Number((q('.breadth-instances') as HTMLInputElement).value),objectives=Number((q('.breadth-objectives') as HTMLInputElement).value);const demo=breadthDemo(count,objectives);const mode=(q('.breadth-mode') as HTMLSelectElement).value;const selected=mode==='instance'?demo.instance:demo.objective;
   q('.instance-count').textContent=String(count);q('.objective-count').textContent=String(objectives);
   for(const kind of ['instance','objective'] as const){q(`.${kind}-size`).textContent=String(demo[kind].alive.size);q(`.${kind}-keys`).textContent=`${kind==='instance'?count:objectives} keys`;q(`.${kind}-bar`).style.width=`${demo[kind].alive.size/12*100}%`;}
   all('[data-parent-index]').forEach((el,i)=>{const id=demo.rows[i].id;el.classList.toggle('removed',!selected.alive.has(id));el.querySelector('span')!.textContent=selected.alive.has(id)?`${(selected.probability[id]*100).toFixed(1)}%`:'Pruned';});
   q('.breadth-result').textContent=`${demo.instance.alive.size} / 12 repositories survive in instance mode; ${demo.objective.alive.size} / 12 survive in objective mode. Showing ${mode} parent-selection probabilities. Each mode uses the same evaluations, summarized with different keys.`;
   const tr=document.createElement('tr');for(const label of ['Repository','Scalar mean',...Array.from({length:objectives},(_,i)=>`Objective ${i+1}`)]){const th=document.createElement('th');th.scope='col';th.textContent=label;tr.append(th);}q('.breadth-data-head').replaceChildren(tr);
   q('.breadth-data-body').replaceChildren(...demo.rows.map(r=>{const row=document.createElement('tr');const th=document.createElement('th');th.scope='row';th.textContent=r.id;row.append(th);for(const v of [mean(r.scores),...r.objectives]){const td=document.createElement('td');td.textContent=v.toFixed(3);row.append(td);}return row;}));
  };all('.breadth input,.breadth select').forEach(el=>el.addEventListener('input',updateBreadth));updateBreadth();
  all('[data-access]').forEach(b=>b.addEventListener('click',()=>{const access=b.dataset.access;q('.boundary').classList.toggle('blocked',access!=='run');q('.boundary-result').textContent=access==='run'?'Allowed: a whitelisted call crosses the sidecar to run the candidate. Permitted scores and diagnostics return through the interface.':access==='read'?'Blocked: evaluator source and benchmark metadata are outside the mutator’s workspace. The agent can consult the public API contract.':'Rejected: protected-file integrity checks prevent a child that changes evaluator-owned artifacts from being promoted.';}));
  all('[data-runtime]').forEach(b=>b.addEventListener('click',()=>{const rai=b.dataset.runtime==='rai';all('[data-runtime]').forEach(el=>{el.setAttribute('aria-pressed',String(el===b));el.classList.toggle('primary',el===b);});q('.runtime-mid').textContent=rai?'RAI’s LLM-in-the-loop driver':'Python controller';q('.runtime-description').textContent=rai?'The evolved repository supplies prompts and tool-edit code. RAI’s existing LLM-driven deployment loop and ROS 2 connector remain in place.':'The evolved repository runs as a controller. Its source stays fixed during the scored rollout, and it can call learned perception services through the documented interface.';}));
 }
}
if(!customElements.get('rho-method'))customElements.define('rho-method',RhoMethod);
</script>
